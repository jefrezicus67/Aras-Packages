//Optimizations via Claude on Community Edition 2025 to try to get faster loading and shorten multi-loads for Edit & Done commands.
IDisposable elevatedPermissionsScope = null;
			String techDocPriveledgedPublisherId = "86F8574A13814269A1CEC0E012AEADB2";
			String identityList = CCO.Permissions.IdentitiesList;

			if (identityList.IndexOf(techDocPriveledgedPublisherId, System.StringComparison.Ordinal) != -1)
			{
				elevatedPermissionsScope = CCO.Permissions.GrantIdentity(_superUserIdentity.Value);
			}

			try
			{
				// === DEDUP CACHE: prevent duplicate tp_DocumentGet calls within rapid transitions ===
				string cacheDocId = this.getID();
				string cacheLang = this.getAttribute("language",
					this.getInnovator().getI18NSessionContext().GetDefaultLanguageCode());
				string cacheByRef = this.getAttribute("by-reference", "internal");
				string cacheLockState = this.getProperty("locked_by_id", "");
				string cacheKey = cacheDocId + "|" + cacheLang + "|" + cacheByRef + "|" + cacheLockState;

				var dedup = GetDedupCache();
				if (dedup.TryGetValue(cacheKey, out var cachedResult)
					&& (DateTime.UtcNow - cachedResult.Item2).TotalSeconds < 5)
				{
					return this.getInnovator().newResult(cachedResult.Item1);
				}
				// === END DEDUP CHECK ===

				// Method is used for SchemaElementsFactory instantiation because it should use the same builder method that is currently active
				RequestState["contentBuilderMethod"] = this.getAction();
				// recursionsCount stores number of content builder method calls in context of same request
				// it should be tracked in order to avoid recursive calls from dynamic content generators
				RequestState["recursionsCount"] = (RequestState.Contains("recursionsCount") ? (int)RequestState["recursionsCount"] : 0) + 1;

				Item itemTypeSettings = GetItemTypeConfigFast(this.getInnovator(), this.getType());

				// Ensure per-request caches are created
				_typeCfgCache.Value = GetTypeCfgCache();
				_latestVersionCache.Value = GetLatestVersionCache();

				Item result = Execute(this, RequestState, itemTypeSettings);

				// === CACHE THE RESULT if successful ===
				if (!result.isError())
				{
					dedup[cacheKey] = Tuple.Create(result.getResult(), DateTime.UtcNow);
				}
				// === END CACHE STORE ===

				return result;
			}
			finally
			{
				elevatedPermissionsScope?.Dispose();

				// Clear per-request caches to avoid accidental leakage across requests
				_typeCfgCache.Value = null;
				_latestVersionCache.Value = null;
			}
		}

		// === DEDUP CACHE: Static concurrent dictionary with 5-second TTL ===
		// Uses ConcurrentDictionary for thread safety across concurrent requests.
		// Cache key includes locked_by_id so that lock state changes (Edit/Done) 
		// always trigger a fresh rebuild, while duplicate calls within the same
		// transition are served from cache.
		private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, Tuple<string, DateTime>>
			_dedupCache = new System.Collections.Concurrent.ConcurrentDictionary<string, Tuple<string, DateTime>>();

		private static System.Collections.Concurrent.ConcurrentDictionary<string, Tuple<string, DateTime>> GetDedupCache()
		{
			// Lazy cleanup: remove entries older than 30 seconds to prevent unbounded growth
			var now = DateTime.UtcNow;
			foreach (var kvp in _dedupCache)
			{
				if ((now - kvp.Value.Item2).TotalSeconds > 30)
				{
					_dedupCache.TryRemove(kvp.Key, out _);
				}
			}
			return _dedupCache;
		}
		// === END DEDUP CACHE ===

		// Per-request caches (AsyncLocal so concurrent requests don't collide)
		private static readonly System.Threading.AsyncLocal<Dictionary<string, Item>> _typeCfgCache = new System.Threading.AsyncLocal<Dictionary<string, Item>>();
		private static readonly System.Threading.AsyncLocal<Dictionary<string, string>> _latestVersionCache = new System.Threading.AsyncLocal<Dictionary<string, string>>();

		// Cache for Super User identity lookup across process lifetime (lazy)
		private static readonly Lazy<Aras.Server.Security.Identity> _superUserIdentity =
				new Lazy<Aras.Server.Security.Identity>(() => Aras.Server.Security.Identity.GetByName("Super User"));

		// Safe getters for the current request's caches
		private static Dictionary<string, Item> GetTypeCfgCache()
				=> _typeCfgCache.Value ?? (_typeCfgCache.Value = new Dictionary<string, Item>(StringComparer.Ordinal));

		private static Dictionary<string, string> GetLatestVersionCache()
				=> _latestVersionCache.Value ?? (_latestVersionCache.Value = new Dictionary<string, string>(StringComparer.Ordinal));

		// Cached ItemType settings
		private static Item GetItemTypeConfigFast(Innovator inn, string type)
		{
			var cache = GetTypeCfgCache();
			if (!cache.TryGetValue(type, out var cfg))
			{
				var req = inn.newItem(type, "tdf_GetItemTypeSettings");
				cfg = req.apply();
				cache[type] = cfg;
			}
			return cfg;
		}

		// Cached latest-version resolution (returns empty string if current or error)
		private static string TryGetLatestVersionIdCached(Item anyItem)
		{
			if (anyItem == null) return string.Empty;

			// If current, no need to look anything up
			var isCurrent = anyItem.getProperty("is_current");
			if (isCurrent != "0") return string.Empty;

			var type = anyItem.getType();
			var id = anyItem.getID();
			if (string.IsNullOrEmpty(type) || string.IsNullOrEmpty(id)) return string.Empty;

			var key = type + ":" + id;
			var cache = GetLatestVersionCache();
			if (cache.TryGetValue(key, out var cached)) return cached;

			// Fallback: single call with caching
			var latestItemVersion = anyItem.newItem(type, "getItemLastVersion");
			latestItemVersion.setID(id);
			latestItemVersion = latestItemVersion.apply();
			if (!latestItemVersion.isError())
			{
				var latestId = latestItemVersion.getID();
				cache[key] = latestId ?? string.Empty;
				return latestId ?? string.Empty;
			}

			cache[key] = string.Empty;
			return string.Empty;
		}


		internal static Item Execute(Item targetDocument, Aras.Server.Core.IContextState requestState, Item itemTypeSettings)
		{
			Innovator innovator = targetDocument.getInnovator();
			String byReference = targetDocument.getAttribute("by-reference", "internal");
			String defaultLangCode = innovator.getI18NSessionContext().GetDefaultLanguageCode();
			String langCode = targetDocument.getAttribute("language", defaultLangCode);
			Item rootBlockItem = GetDocumentStructure(targetDocument, langCode, itemTypeSettings);

			if (rootBlockItem.isError())// something's wrong. There is no element with such blockId or the user does not have permissions to get it
			{
				return innovator.newError(rootBlockItem.getErrorString());
			}

			string schemaPropertyName = itemTypeSettings.getProperty("datamodel.schemaPropertyName");
			Item externalLinks = GetDocumentExternalLinks(targetDocument, itemTypeSettings);
			Item xmlSchema = rootBlockItem.getPropertyItem(schemaPropertyName);

			StringBuilder docContent = new StringBuilder();
			XmlWriterSettings settings = new XmlWriterSettings();
			settings.Indent = false;
			settings.OmitXmlDeclaration = true;

			using (XmlWriter xw = XmlWriter.Create(docContent, settings))
			{
				xw.WriteStartElement("aras", "document", "http://aras.com/ArasTechDoc");
				{
					xw.WriteStartAttribute("xmlns");
					xw.WriteValue(xmlSchema.getProperty("target_namespace"));
					xw.WriteEndAttribute();

					xw.WriteStartAttribute("schemaid");
					xw.WriteValue(xmlSchema.getID());
					xw.WriteEndAttribute();

					xw.WriteStartElement("aras", "content", "http://aras.com/ArasTechDoc");
					{
						AppendBlock(xw, langCode, rootBlockItem, null, byReference, itemTypeSettings);
					}
					xw.WriteEndElement();

					// build referencesXmls and updated content for elements with dynamic content generators
					Dictionary<String, String> referenceItemXmls = GetAllReferenceXmls(rootBlockItem, byReference == "external", langCode, itemTypeSettings);
					Tuple<Dictionary<String, XmlNode>, Dictionary<String, XmlNode>> updatedDynamicData = GetDynamicElementsData(innovator, requestState, rootBlockItem, langCode, referenceItemXmls, itemTypeSettings);
					Dictionary<String, XmlNode> customContentNodes = updatedDynamicData.Item1;
					Dictionary<String, XmlNode> customContentReferences = updatedDynamicData.Item2;

					// append document external references to output
					xw.WriteStartElement("aras", "references", "http://aras.com/ArasTechDoc");
					{
						foreach (KeyValuePair<String, String> referenceXmlData in referenceItemXmls)
						{
							xw.WriteRaw(referenceXmlData.Value);
							customContentReferences.Remove(referenceXmlData.Key);
						}

						foreach (XmlNode referenceNode in customContentReferences.Values)
						{
							referenceNode.WriteTo(xw);
						}
					}
					xw.WriteEndElement();

					// append externalLinks to output
					xw.WriteStartElement("aras", "externalLinks", "http://aras.com/ArasTechDoc");
					{
						for (int i = 0; i < externalLinks.getItemCount(); i++)
						{
							Item sourceBlock = externalLinks.getItemByIndex(i);
							Item linkReference = sourceBlock.getRelationships(itemTypeSettings.getProperty("datamodel.relationships.linkReference")).getItemByIndex(0);

							AppendExternalLink(xw, sourceBlock, linkReference);
						}
					}
					xw.WriteEndElement();

					// append generatedContent if dynamic elements present in document
					xw.WriteStartElement("aras", "generatedContent", "http://aras.com/ArasTechDoc");
					{
						foreach (XmlNode elementNode in customContentNodes.Values)
						{
							elementNode.WriteTo(xw);
						}
					}
				}
				xw.WriteEndElement();
			}

			return innovator.newResult(docContent.ToString());
		}

		internal static string GetDocumentItemRequestAml(Innovator innovator, string type, string language, bool root = true)
		{
			Item itemTypeSettings = GetItemTypeConfig(innovator, type);

			string documentReference = itemTypeSettings.getProperty("datamodel.relationships.documentReference");
			string imageReference = itemTypeSettings.getProperty("datamodel.relationships.imageReference");
			string itemReference = itemTypeSettings.getProperty("datamodel.relationships.itemReference");
			string linkReference = itemTypeSettings.getProperty("datamodel.relationships.linkReference");
			string schemaProperty = itemTypeSettings.getProperty("datamodel.schemaPropertyName");
			string externalDocumentType = itemTypeSettings.getProperty("datamodel.relationships.documentReferenceRelatedType", type);
			bool sameDocumentTypes = string.Equals(type, externalDocumentType, StringComparison.Ordinal);

			return $@"
				<Item type='{type}' select='id,content,{schemaProperty},condition,config_id,name,item_number,is_current,major_rev,generation,locked_by_id,modified_on' action='{(sameDocumentTypes ? "GetItemRepeatConfig" : "get")}' language='{language}'>
					{(root ? $@"<{schemaProperty}>
						<Item type='tp_XmlSchema' select='name,content,target_namespace' action='get'>
							<Relationships>
								<Item type='tp_XmlSchemaElement' action='get' select='name,content_generator,is_content_dynamic'/>
							</Relationships>
						</Item>
					</{schemaProperty}>" : String.Empty)}
					<Relationships>
						{(sameDocumentTypes
							? $@"<Item type='{documentReference}' select='reference_id,ignore_all_versions,ignored_version_id,related_id' repeatTimes='0' repeatProp='related_id'></Item>"
							: $@"<Item type='{documentReference}' select='reference_id,ignore_all_versions,ignored_version_id,related_id'>
										<related_id>{GetDocumentItemRequestAml(innovator, externalDocumentType, language, false)}</related_id>
									</Item>"
						)}
						<Item type='{imageReference}' select='reference_id,ignore_all_versions,ignored_version_id,related_id(id,src,is_current,major_rev,generation)'></Item>
						<Item type='{itemReference}' select='reference_id,ignore_all_versions,ignored_version_id,related_id'></Item>
						<Item type='{linkReference}' select='reference_id,path,related_id,targetelement'></Item>
					</Relationships>
				</Item>";
		}

		internal static Item GetDocumentStructure(Item documentItem, String languageCode, Item itemTypeSettings)
		{
			Item requestItem = documentItem.newItem();
			string documentItemGetter = itemTypeSettings.getProperty("documentItemGetter");
			string type = documentItem.getType();

			if (string.IsNullOrEmpty(documentItemGetter))
			{
				string documentStructureAml = GetDocumentItemRequestAml(documentItem.getInnovator(), type, languageCode); 
				#pragma warning disable IA1000 // Improper escaping of Special Elements used in an AML Query
				requestItem.loadAML(documentStructureAml);
				#pragma warning restore IA1000 // Improper escaping of Special Elements used in an AML Query
				requestItem.setID(documentItem.getID());
			}
			else
			{
				requestItem.setAction(documentItemGetter);
				requestItem.setType(type);
				requestItem.setAttribute("language", languageCode);
				requestItem.setID(documentItem.getID());
			}

			return requestItem.apply();
		}

		internal static Item GetDocumentExternalLinks(Item documentItem, Item itemTypeSettings)
		{
			string linkReference = itemTypeSettings.getProperty("datamodel.relationships.linkReference");
			string type = documentItem.getType();
			string id = documentItem.getID();

			String externalLinksAml = $@"
				<Item type='{type}' action='get'>
					<Relationships>
						<Item type='{linkReference}' action='get'>
							<related_id>{id}</related_id>
						</Item>
					</Relationships>
				</Item>";

			Item requestItem = documentItem.newItem();
			#pragma warning disable IA1000 // Improper escaping of Special Elements used in an AML Query
			requestItem.loadAML(externalLinksAml);
			#pragma warning restore IA1000 // Improper escaping of Special Elements used in an AML Query

			return requestItem.apply();
		}

		internal static Item GetItemTypeConfig(Innovator innovator, string type)
		{
			var request = innovator.newItem(type, "tdf_GetItemTypeSettings");
			return request.apply();
